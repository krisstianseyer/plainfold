{
  "name": "plainfold",
  "version": "0.1.20",
  "private": true,
  "description": "Plainfold: a plain-text vault editor",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "node scripts/gen-icon.mjs && tauri icon assets/icon-master.png -o src-tauri/icons",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "node --test tests/frontend/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "vite": "8.3.4"
  }
